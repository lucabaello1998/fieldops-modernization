APP_NAME="FieldOps"
APP_ENV=local
# Clave solo para la demo: en un entorno real, `php artisan key:generate`.
APP_KEY=base64:TtGom7Oal3ZgEeK5ZYTHxS25YElMWZnjELAKCXP2zx4=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dentro de Docker el host de MySQL es el nombre del servicio (`db`).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fieldops
DB_USERNAME=fieldops
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@fieldops.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
